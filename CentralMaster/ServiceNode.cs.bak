		public ServiceNode(byte[] node_ipv6addr, byte[] ext_addr, G3.HostMessages host_messaging, 
		                   System.Timers.Timer app_timer, Communications.ITransmit itransmit_comms, 
						   int rd_rx_timeout_ms, int rd_confirmation_timeout_secs)
		{
			// node is created when a new ATTACH message is received by the device
			_node_ipv6addr = new byte[node_ipv6addr.Length];
			Array.Copy(node_ipv6addr, _node_ipv6addr, node_ipv6addr.Length);
			_node_ipv6addr_str = BitConverter.ToString(node_ipv6addr);
			_extended_addr = new byte[ext_addr.Length];
			Array.Copy(ext_addr, _extended_addr, ext_addr.Length);
			_host_messaging = host_messaging;
			main_timer = app_timer;
			timer_interval = main_timer.Interval;
			_itransmit_comms = itransmit_comms;
			StartServiceNodeStateMachine();
			for (int ii = 0; ii < NODE_CAPABILITY_IDS.Length; ii++)
			{
				id_name.Add(NODE_CAPABILITY_IDS[ii], NODE_CAPABILITY_NAMES[ii]);
				id_length.Add(NODE_CAPABILITY_IDS[ii], NODE_CAPABILITY_DATA_LENGTHS[ii]);
			}

			rd_rx_timeout_milliseconds = rd_rx_timeout_ms;
			rd_confirmation_timeout_millisecs = rd_confirmation_timeout_secs * 1000; 
			_attach_time = DateTime.Now;
		}


		#region state_machine
		private void StartServiceNodeStateMachine()
		{
			sentCommonNameRequest = false;
			receivedCommonNameResponse = false;
			sentCapabilityRequest = false;
			receivedCapabilityResponse = false;
			sentProtocolSetupRequest = false;
			receivedProtocolSetupResponse = false;
			// _current_state = (ushort)ServiceNodeStates.ATTACHED;
			// StateMachine(); // moves it to common name state
			_current_state = (ushort)ServiceNodeStates.PROTOCOL_SETUP;
			_pause_state_machine = true;
			//StateMachine();
		}

		public void ExtStateMachine()
		{
			//Console.WriteLine("SM: EXT State machine");
			Task.Run( () => CheckExecuteStateMachine(false));
		}

		private void CheckExecuteStateMachine(bool wait_and_execute)
		{
			// if bool wait_and_exec is true, wait for current statemachine to complete and then execute
			// else if wait_and_exec is false, exit immediately without calling statemachine
			bool is_exec;
			int loop_max; // 300 ms it must finish
			lock(_state_machine_lock)
			{
				is_exec = _state_machine_exec;
			}
			if (!wait_and_execute)
			{
				if (!is_exec)
				{
					// debug
					//Console.WriteLine("CESM: Executing SM");
					StateMachine();
				}
			}
			else 
			{
				loop_max = 0;
				while ( (is_exec) && (loop_max < 10) ) 
				{
					System.Threading.Thread.Sleep(100);
					loop_max ++;
					// wait for current execution to complete
					lock(_state_machine_lock)
					{
						is_exec = _state_machine_exec;
					}
				}
				if (!is_exec) 
				{
					// debug
					//Console.WriteLine("CESM: Executing SM");
					StateMachine();
				} 
				else 
				{
					Console.WriteLine("Wait to execute state machine failed. Current Exection of state machine did not complete in 1sed");
				}
			}
		}
		private void StateMachine()
		{
			lock(_state_machine_lock)
			{
				_state_machine_exec = true;
			}
			//Console.WriteLine(string.Format("executing state machine => {0}", _current_state));
			//Console.WriteLine(string.Format("state machine {2} => 0x{0:x} at {1}", _current_state, 
			//	DateTime.Now.TimeOfDay.ToString(), BitConverter.ToString(_node_ipv6addr)));

			if (_pause_state_machine)
			{
				lock(_state_machine_lock)
				{
					_state_machine_exec = false;
				}
				//Console.WriteLine("DONE executing state machine in pause.");
				return;
			}
			if (_current_state == (ushort)ServiceNodeStates.ATTACHED)
			{
				//Thread.Sleep(500);
				//_current_state = (ushort)(ServiceNodeStates.COMMON_NAME);
				_current_state = (ushort)(ServiceNodeStates.PROTOCOL_SETUP);
			}
			else if (_current_state == (ushort) ServiceNodeStates.PROTOCOL_SETUP)
			{
				Console.WriteLine("in protocol setup state machine");
				ProtocolSetupTask();
			}
			// else if (_current_state == (ushort)ServiceNodeStates.COMMON_NAME)
			// {
			// 	CommonNameTask();
			// }
			// else if (_current_state == (ushort)ServiceNodeStates.SYNC_TIME)
			// {
			// 	SyncTimeTask();
			// }
			// else if (_current_state == (ushort)ServiceNodeStates.CAPABILITY)
			// {
			// 	CapabilityTask();
			// }
			else if (_current_state == (ushort)ServiceNodeStates.COMM_READY)
			{
				CommReadyTask();
			}
			else if (_current_state == (ushort)ServiceNodeStates.SHUTDOWN)
			{
				// do nothing
				// cannot leave shutdown state.. will not process any data... need to dispose and create a new node
				_pause_state_machine = true;
			}
			lock(_state_machine_lock)
			{
				_state_machine_exec = false;
			}
			//Console.WriteLine("DONE executing state machine");

		}

		private void StateMachineNextState(string trigger_str)
		{
			// bool state_changed = false;
			if ((_current_state == (ushort)ServiceNodeStates.COMMON_NAME) &&
				(trigger_str.Equals("RECEIVED_COMMON_NAME_RESPONSE"))
			)
			{
				_current_state = (ushort)ServiceNodeStates.SYNC_TIME;
				// state_changed = true;
			}
			else if ((_current_state == (ushort)ServiceNodeStates.SYNC_TIME) &&
				(trigger_str.Equals("RECEIVED_SYNC_TIME_RESPONSE"))
			)
			{
				_current_state = (ushort)ServiceNodeStates.CAPABILITY;
				// state_changed = true;
			}
			else if ((_current_state == (ushort)ServiceNodeStates.CAPABILITY) &&
				(trigger_str.Equals("RECEIVED_CAPABILITY_RESPONSE"))
			)
			{
				_current_state = (ushort)ServiceNodeStates.COMM_READY;
				// state_changed = true;
			}
			else if ((_current_state == (ushort) ServiceNodeStates.PROTOCOL_SETUP) &&
				(trigger_str.Equals("RECEIVED_PROTOCOLSETUP_RESPONSE"))
			)
			{
				// debug
				//Console.WriteLine("going to comm ready from proto setup");
				_current_state = (ushort)ServiceNodeStates.COMM_READY;
				// state_changed = true;
			}
			else if ( ( (_current_state == (ushort) ServiceNodeStates.PROTOCOL_SETUP) || 
						(_current_state == (ushort)ServiceNodeStates.COMM_READY) ) &&
					  (trigger_str.Equals("SHUTDOWN")
				    )
			)
			{
				_current_state = (ushort)ServiceNodeStates.SHUTDOWN;
				// state_changed = true;
			}

			// if ( (state_changed) && (trigger_str.Equals("SHUTDOWN") ) )
			// {
			// 	//Console.WriteLine("in state changed statemachine call");
			// 	Console.WriteLine("SM: state changed State machine");
			// 	CheckExecuteStateMachine(true);
			// }
		}

		private void CommonNameTask()
		{
			if (recv_b != null)
			{
				ushort message_id = BitConverter.ToUInt16(recv_b, 2);
				if (message_id == (ushort)ProtocolIdentifiers.COMMON_NAME_RESPONSE_ID)
				{
					ProcessCommonNameData(recv_b);
					recv_b = null;
					receivedCommonNameResponse = true;
					_updateViewThisSerialNumber = false;
				}
			}

			if (!sentCommonNameRequest || !receivedCommonNameResponse)
			{
				if ((!sentCommonNameRequest) || (sentCommonNameRequest && (DateTime.Now.Subtract(time_sent).TotalSeconds >= TIMEOUT_SECS)))
				{
					ushort pkt_len = ProtocolMessagesG3PLC.CommonNameRequestPacketLen();
					byte[] pkt = new byte[pkt_len];
					ProtocolMessagesG3PLC.CommonNameRequestPacket(pkt, pkt_len);
					TransmitDataToNode(pkt, _node_ipv6addr, true);
					time_sent = DateTime.Now;
					sentCommonNameRequest = true;
					startCounting(TIMEOUT_SECS + rnd_node.Next(-15, 15)); // ADD A RANDOM plus or minus 15 SECS DELAY
				}
			}
			else if (receivedCommonNameResponse)
			{
				// goto next state
				StateMachineNextState("RECEIVED_COMMON_NAME_RESPONSE");
			}

		}

		private void SyncTimeTask()
		{
			if (recv_b != null)
			{
				ushort message_id = BitConverter.ToUInt16(recv_b, 2);
				if (message_id == (ushort)ProtocolIdentifiers.SYNC_TIME_RESPONSE_ID)
				{
					// process time data
					if (recv_b[4] == 0x00) // success
					{
						receivedSyncTimeResponse = true;
					}
					recv_b = null;
				}
			}
			if (!sentSyncTimeRequest || !receivedSyncTimeResponse)
			{
				if ((!sentSyncTimeRequest) || (sentSyncTimeRequest && (DateTime.Now.Subtract(time_sent).TotalSeconds >= TIMEOUT_SECS)))
				{
					ushort pkt_len = ProtocolMessagesG3PLC.SyncTimeRequestPacketLen();
					byte[] pkt = new byte[pkt_len];
					byte[] time_b;
					StringBuilder sb = new StringBuilder();
					DateTime curr_time = DateTime.Now;
					sb.Append(string.Format("{0:d2}{1:d2}{2:d2}", curr_time.Month, curr_time.Day, curr_time.Year - 2000));
					sb.Append(string.Format("{0:d2}{1:d2}{2:d2}", curr_time.Hour, curr_time.Minute, curr_time.Second));
					sb.Append(string.Format("{0:d2}", curr_time.DayOfWeek ) );
					time_b = ASCIIEncoding.ASCII.GetBytes(sb.ToString());
					ProtocolMessagesG3PLC.SyncTimeRequestPacket(pkt, pkt_len, time_b, (ushort)time_b.Length);
					TransmitDataToNode(pkt, _node_ipv6addr, true);
					time_sent = DateTime.Now;
					sentSyncTimeRequest = true;
					startCounting(TIMEOUT_SECS + rnd_node.Next(-15, 15)); // ADD A RANDOM plus or minus 15 SECS DELAY
				}
			}
			else if (receivedSyncTimeResponse)
			{
				// goto next state
				StateMachineNextState("RECEIVED_SYNC_TIME_RESPONSE");
			}
		}

		private void CapabilityTask()
		{
			if (recv_b != null)
			{
				ushort message_id = BitConverter.ToUInt16(recv_b, 2);
				if (message_id == (ushort)ProtocolIdentifiers.CAPABILITY_RESPONSE_ID)
				{
					ProcessCapabilityData(recv_b);
					recv_b = null;
					receivedCapabilityResponse = true;
				}
			}
			if (!sentCapabilityRequest || !receivedCapabilityResponse)
			{
				if ((!sentCapabilityRequest) || (sentCapabilityRequest && (DateTime.Now.Subtract(time_sent).TotalSeconds >= TIMEOUT_SECS)))
				{
					ushort pkt_len = ProtocolMessagesG3PLC.CapabilityRequestPacketLen();
					byte[] pkt = new byte[pkt_len];
					ProtocolMessagesG3PLC.CapabilityRequestPacket(pkt, pkt_len);
					TransmitDataToNode(pkt, _node_ipv6addr, true);
					time_sent = DateTime.Now;
					sentCapabilityRequest = true;
					startCounting(TIMEOUT_SECS + rnd_node.Next(-15, 15)); // ADD A RANDOM plus or minus 15 SECS DELAY
				}
			}
			else if (receivedCapabilityResponse)
			{
				// goto next state
				StateMachineNextState("RECEIVED_CAPABILITY_RESPONSE");
			}
		}

		private void ProtocolSetupTask()
		{
			int index;
			byte[] tmp_b;
			int tmp_b_len;
			// if asked to shutdown go to the shutdown state
			if (shutdownRequest)
			{
				StateMachineNextState("SHUTDOWN");
				recv_b = null;
				return;
			}

			if (recv_b != null)
			{
				// debug
				//Console.WriteLine(BitConverter.ToString(recv_b));
				index = 2;
				while (index < recv_b.Length)
				{
					// debug
					//Console.WriteLine(string.Format("index protocol setup task : {0}, tot len {1}", index, recv_b.Length));
					ushort message_id = BitConverter.ToUInt16(recv_b, index+2);
					if (message_id == (ushort)ProtocolIdentifiers.COMMON_NAME_RESPONSE_ID)
					{
						tmp_b_len = BitConverter.ToUInt16(recv_b, index);
						tmp_b = new byte[tmp_b_len];
						Array.Copy(recv_b, index, tmp_b, 0, tmp_b_len);
						ProcessCommonNameData(tmp_b);
						receivedCommonNameResponse = true;
						_updateViewThisSerialNumber = false;
						index += tmp_b_len;
					}
					else if (message_id == (ushort)ProtocolIdentifiers.SYNC_TIME_RESPONSE_ID)
					{
						tmp_b_len = BitConverter.ToUInt16(recv_b, index);
						tmp_b = new byte[tmp_b_len];
						// process time data
						if (recv_b[index+4] == 0x00) // success
						{
							receivedSyncTimeResponse = true;
						}
						index += tmp_b_len;
					}
					else if (message_id == (ushort)ProtocolIdentifiers.CAPABILITY_RESPONSE_ID)
					{
						tmp_b_len = BitConverter.ToUInt16(recv_b, index);
						tmp_b = new byte[tmp_b_len];
						Array.Copy(recv_b, index, tmp_b, 0, tmp_b_len);
						ProcessCapabilityData(tmp_b);
						receivedCapabilityResponse = true;
						index += tmp_b_len;
					}
					else if (message_id == (ushort)ProtocolIdentifiers.DATA_RESPONSE_ID) {
						tmp_b_len = BitConverter.ToUInt16(recv_b, index);
						tmp_b = new byte[tmp_b_len];
						Array.Copy(recv_b, index, tmp_b, 0, tmp_b_len);
						//ProcessDataResponse(tmp_b);
						ProcessAsRRCommand(tmp_b);
						index += tmp_b_len;
					}
					// debug
					//Console.WriteLine(string.Format("recv common: {0}, recv synctime {1}, recv capab {2}", receivedCommonNameResponse, receivedSyncTimeResponse, receivedCapabilityResponse));
					if (receivedCommonNameResponse && receivedSyncTimeResponse && receivedCapabilityResponse)
					{
						receivedProtocolSetupResponse = true;
					}
				}
				recv_b = null;
			}
			//Console.WriteLine(string.Format("sent protocol request {0}, recv proto resp {1}", sentProtocolSetupRequest, receivedProtocolSetupResponse));
			// if (!sentProtocolSetupRequest || !receivedProtocolSetupResponse)
			// {
			// 	if ((!sentProtocolSetupRequest) || (sentProtocolSetupRequest && (DateTime.Now.Subtract(time_sent).TotalSeconds >= TIMEOUT_SECS)))
			// 	{

			// 		ushort pkt_len1 = ProtocolMessagesG3PLC.CommonNameRequestPacketLen();
			// 		ushort pkt_len2 = ProtocolMessagesG3PLC.SyncTimeRequestPacketLen();
			// 		ushort pkt_len3 = ProtocolMessagesG3PLC.CapabilityRequestPacketLen();
			// 		ushort combo_pkt_len = (ushort)(pkt_len1 + pkt_len2 + pkt_len3+2);
			// 		byte[] combo_pkt = new byte[combo_pkt_len];

			// 		byte[] pkt1 = new byte[pkt_len1];
			// 		ProtocolMessagesG3PLC.CommonNameRequestPacket(pkt1, pkt_len1);
			// 		ushort tmpu2 = ProtocolMessagesG3PLC.AppendPacket(combo_pkt, combo_pkt_len, false, pkt1, pkt_len1);

			// 		byte[] pkt2 = new byte[pkt_len2];
			// 		byte[] time_b;
			// 		StringBuilder sb = new StringBuilder();
			// 		DateTime curr_time = DateTime.Now;
			// 		sb.Append(string.Format("{0:d2}{1:d2}{2:d2}", curr_time.Month, curr_time.Day, curr_time.Year - 2000));
			// 		sb.Append(string.Format("{0:d2}{1:d2}{2:d2}", curr_time.Hour, curr_time.Minute, curr_time.Second));
			// 		time_b = ASCIIEncoding.ASCII.GetBytes(sb.ToString());
			// 		ProtocolMessagesG3PLC.SyncTimeRequestPacket(pkt2, pkt_len2, time_b, (ushort)time_b.Length);
			// 		tmpu2 = ProtocolMessagesG3PLC.AppendPacket(combo_pkt, combo_pkt_len, true, pkt2, pkt_len2);

			// 		byte[] pkt3 = new byte[pkt_len3];
			// 		ProtocolMessagesG3PLC.CapabilityRequestPacket(pkt3, pkt_len3);
			// 		tmpu2 = ProtocolMessagesG3PLC.AppendPacket(combo_pkt, combo_pkt_len, true, pkt3, pkt_len3);
					
			// 		TransmitDataToNode(combo_pkt, _node_ipv6addr, true);
			// 		time_sent = DateTime.Now;
			// 		sentProtocolSetupRequest = true;
			// 		startCounting(TIMEOUT_SECS + rnd_node.Next(-15, 15)); // ADD A RANDOM plus or minus 15 SECS DELAY
			// 	}
			// }
			// else if (receivedProtocolSetupResponse)
			// {
			// 	// goto next state
			// 	StateMachineNextState("RECEIVED_PROTOCOLSETUP_RESPONSE");
			// }
			if (receivedProtocolSetupResponse)
			{
				// goto next state
				StateMachineNextState("RECEIVED_PROTOCOLSETUP_RESPONSE");
			}
		}


		private void CommReadyTask()
		{
			int recv_idx;
			ushort message_id;
			int message_len;
			// if asked to shutdown go to the shutdown state
			if (shutdownRequest)
			{
				StateMachineNextState("SHUTDOWN");
				recv_b = null;
				return;
			}
			//Console.WriteLine("start of comm ready task");
			if (recv_b != null)
			{
				recv_idx = 2;
				while (recv_idx < recv_b.Length)
				{
					message_len = BitConverter.ToUInt16(recv_b, recv_idx);
					message_id = BitConverter.ToUInt16(recv_b, recv_idx+2);
					// debug
					//Console.WriteLine(string.Format("idx {0}, total len {1}, message len {2}, message id {3}", recv_idx, recv_b.Length, message_len, message_id));
					byte[] tmp_pkt = new byte[message_len];
					Array.Copy(recv_b, recv_idx, tmp_pkt, 0, message_len);
					recv_idx += message_len;
					if (message_id == (ushort)ProtocolIdentifiers.DATA_RESPONSE_ID)
					{
						ProcessAsRRCommand(tmp_pkt);
						//ProcessDataResponse(tmp_pkt);
						tmp_pkt = null;
					}
					else if (message_id == (ushort)ProtocolIdentifiers.COMMAND_RESPONSE_ID)
					{
						ProcessCommandResponse(tmp_pkt);
						tmp_pkt = null;
					}
					else if (message_id == (ushort) ProtocolIdentifiers.BRIDGENODE_DATA_RESPONSE_ID)
					{
						ProcessBridgeNodeDataResponse(tmp_pkt);
						tmp_pkt = null;
					}
					else if (message_id == (ushort) ProtocolIdentifiers.BRIDGENODE_COMMAND_RESPONSE_ID)
					{
						ProcessBridgeNodeDataResponse(tmp_pkt);
						tmp_pkt = null;
					}
					else if (message_id == (ushort) ProtocolIdentifiers.RS232_RESPONSE_ID )
					{
						ProcessAsRRCommand(tmp_pkt);
						//ProcessRs232Response(tmp_pkt);
						tmp_pkt = null;
					} 
					else
					{
						ProcessGenericResponse(tmp_pkt);
						tmp_pkt = null;
					}
				}
			}
			//Console.WriteLine("END of comm ready task");
		}

		private void ProcessReceivedMessage(object[] msg_recv)
		{
			//byte[] msg_bytes = null;
			//ushort tmpu16;
			if ( ((byte)msg_recv[0] == (byte)CommandTypes.DATA_TRANSFER) && (msg_recv[1] is G3.DataTransferIndication) )
			{
				// processs data 
				//Console.WriteLine("callling recv autoreset set ");
				G3.DataTransferIndication dti = (G3.DataTransferIndication)msg_recv[1];
				link_qti = (int)dti.link_quality; // this will be appended when sending data to GUI
				//Console.WriteLine(dti.ToString());
			// 	if ( (dti.data_recv[2+2] == 0x04) && (dti.data_recv[3+2] == 0x00) ) // +2 for addition for packaged messages
			// 	{
			// 		// need to add link quality indicator to message bytes ( 2 bytes for link quality id, and 2 bytes for teh value)
			// 		msg_bytes = new byte[dti.data_recv.Length + 4]; // for link quality indication (current reproted values in range 0x00-0xFF but using uint16 for future upgrades)
			// 		// it is data response, only then modify the capability
			// 		Array.Copy(dti.data_recv, msg_bytes, dti.data_recv.Length);
			// 		tmpu16 = BitConverter.ToUInt16(msg_bytes,0); // msg size at combined packet
			// 		tmpu16 += 4;
			// 		byte[] tmpb = BitConverter.GetBytes(tmpu16);
			// 		msg_bytes[0] = tmpb[0];
			// 		msg_bytes[1] = tmpb[1];
			// 		tmpu16 = BitConverter.ToUInt16(msg_bytes,2); // msg szie of first packet 
			// 		tmpu16 += 4;
			// 		byte[] tmpb2 = BitConverter.GetBytes(tmpu16);
			// 		msg_bytes[2] = tmpb2[0];
			// 		msg_bytes[3] = tmpb2[1];
			// 		tmpu16 = BitConverter.ToUInt16(msg_bytes,4+2); // number of capability ids in message
			// 		tmpu16 += 1;
			// 		tmpb = BitConverter.GetBytes(tmpu16);
			// 		msg_bytes[4+2] = tmpb[0];
			// 		msg_bytes[5+2] = tmpb[1];
			// 		// little endian format
			// 		msg_bytes[dti.data_recv.Length] = (byte)( (ushort)ServiceNodeCapability.CPB_LINK_QUALITY & 0x00FF );
			// 		msg_bytes[dti.data_recv.Length+1] = (byte)( ((ushort)ServiceNodeCapability.CPB_LINK_QUALITY & 0xFF00) >> 8 );
			// 		msg_bytes[dti.data_recv.Length+2] = dti.link_quality;
			// 		msg_bytes[dti.data_recv.Length+3] = 0x00;
			// 		//Console.WriteLine("finished modifying recv message data confirmation");
			// 	}
			// 	else 
			// 	{
			// 		msg_bytes = new byte[dti.data_recv.Length];
			// 		Array.Copy(dti.data_recv, msg_bytes, dti.data_recv.Length);
			// 	}

				if (dti.data_recv == null)
				{
					return;
				}
				// require a minimum of 6 bytes to process
				if (dti.data_recv.Length < 5)
				{
					// TODO: send message to console that INVALID DATA is received
					return;
				}
				receive_id = BitConverter.ToUInt16(dti.data_recv, 2+2);	
				Console.WriteLine(string.Format("tx id {0}, rx id {1}", transmit_id, receive_id));
				if ( ((transmit_id+1) == receive_id) || 
					 (transmit_id == ProtocolMessagesG3PLC.DATA_REQUEST_ID  && receive_id == ProtocolMessagesG3PLC.BRIDGENODE_DATA_RESPONSE_ID) ||
					 (transmit_id == ProtocolMessagesG3PLC.COMMAND_REQUEST_ID && receive_id == ProtocolMessagesG3PLC.DATA_RESPONSE_ID) ||
					 (transmit_id == ProtocolMessagesG3PLC.COMMAND_REQUEST_ID && receive_id == ProtocolMessagesG3PLC.BRIDGENODE_DATA_RESPONSE_ID)
				   )
				{
					lock(_tx_rx_lock)
					{
						_tx_rx_resp = true;
					}
				}
				// copy data to recv global buffer
				recv_b = new byte[dti.data_recv.Length];
				if (_data_cmd_done)
				{
					if (_number_async_messages > 0)
					{
						_number_async_messages--;
					}
				}
				Array.Copy(dti.data_recv, recv_b, dti.data_recv.Length);
				//Console.WriteLine("SM: Process Recv Message State machine");
				CheckExecuteStateMachine(true);
				resp_recv_event.Set();
			}
			else if ( ((byte)msg_recv[0] == (byte)CommandTypes.DATA_TRANSFER) && (msg_recv[1] is G3.DataTransferConfirm) )
			{

				// if status is error, then call 
				G3.DataTransferConfirm dtc = (G3.DataTransferConfirm) msg_recv[1];
				Console.WriteLine(dtc.ToString());
				confirmation_recv_event.Set();
				if (dtc.status != 0x0000)
				{
					// an error occured, so relese the wait event, as we may not get a response
					resp_recv_event.Set();
					_exit_mode = true;
				}
			}
		}


		private void ProcessCommonNameData(byte[] msg_bytes)
		{
			ushort common_name_len = BitConverter.ToUInt16(msg_bytes, 4);
			string tmpstr = System.Text.Encoding.UTF8.GetString(msg_bytes, 6, common_name_len);
			string[] tmp_parts = tmpstr.Split(new char[] { ';' }, StringSplitOptions.RemoveEmptyEntries);
			_common_name = tmp_parts[0];
			if (tmp_parts.Length > 1)
			{
				_serial_num = tmp_parts[1];
			}
		}

		private void ProcessCapabilityData(byte[] msg_bytes)
		{
			// debug
			Console.WriteLine("Skip Sending capability data to ui");
			//SendToUserInterface(_node_ipv6addr, _common_name, _serial_num, msg_bytes);
			uint capability_len = BitConverter.ToUInt16(msg_bytes, 4);
			_capability = new ushort[capability_len];
			for (int ii = 0; ii < capability_len; ii++)
			{
				_capability[ii] = BitConverter.ToUInt16(msg_bytes, 6 + (ii * 2));
			}
		}

		private void ProcessAsRRCommand(byte[] msg_bytes)
		{
			if (curr_rr_cmd != null)
			{
				List<ResponseData> list_rd = DeviceData.ComputeValues(curr_rr_cmd.device_name, curr_rr_cmd.command_name, msg_bytes);
				if (list_rd != null)
				{
					foreach(var tmp_rd in list_rd)
					{
						Console.WriteLine(tmp_rd.ToString());
					}
				}

				if (curr_rr_cmd.command_type.Equals("init"))
				{
					initialized.AddOrUpdate(curr_rr_cmd.uuid, true, (key, oldvalue) => oldvalue);
				}
				else if (curr_rr_cmd.command_type.Equals("config") )
				{
					configured.AddOrUpdate(curr_rr_cmd.uuid, true, (key , oldvalue) => oldvalue);
					//Console.WriteLine(string.Format("updated status of configured {0}", configured[curr_rr_cmd.uuid]));
					//Console.WriteLine(configured[curr_rr_cmd.uuid]);
				}
				curr_rr_cmd = null;
			}
			SendToUserInterface(_node_ipv6addr, _common_name, _serial_num, msg_bytes);
		}
		private void ProcessRs232Response(byte[] msg_bytes)
		{
			if (send_to_cloud)
			{
				if (curr_rr_cmd != null)
				{
                    //Console.WriteLine(string.Format("Processing cmd -> {0}", curr_rr_cmd.command_type));
					List<SensorData> to_upload_d = null;
					string dev_name = _common_name + "-" + _serial_num;
					if (curr_rr_cmd.command_name.Equals("Get Weather Data"))
					{
						to_upload_d = PushProcessing.GetWeatherData(msg_bytes, curr_rr_cmd);
					} 
					else if (curr_rr_cmd.command_name.Equals("Get PM2.5 Data")) 
					{
						to_upload_d = PushProcessing.GetPM2_5Data(msg_bytes, curr_rr_cmd);
					}
					if (curr_rr_cmd.command_type.Equals("init"))
					{
						initialized.AddOrUpdate(curr_rr_cmd.uuid, true, (key, oldvalue) => oldvalue);
					}
					else if (curr_rr_cmd.command_type.Equals("config") )
					{
						configured.AddOrUpdate(curr_rr_cmd.uuid, true, (key , oldvalue) => oldvalue);
                    //Console.WriteLine(string.Format("updated status of configured {0}", configured[curr_rr_cmd.uuid]));
                    //Console.WriteLine(configured[curr_rr_cmd.uuid]);
					}
					curr_rr_cmd = null;
					// push to cloud server
					if ( to_upload_d != null )
					{
						Task.Run(() => Communications.AzurePushCommunications.transmit(to_upload_d));
					}
				}
				else 
				{
					Console.WriteLine("null json command, cannot interpret data");
					SendToUserInterface(_node_ipv6addr, _common_name, _serial_num, msg_bytes);
				}
			}
			else 
			{
				if (curr_rr_cmd != null)
				{
					List<ResponseData> list_rd = DeviceData.ComputeValues(curr_rr_cmd.device_name, curr_rr_cmd.command_name, msg_bytes);
					if (list_rd != null)
					{
						foreach(var tmp_rd in list_rd)
						{
							Console.WriteLine(tmp_rd.ToString());
						}
					}

					if (curr_rr_cmd.command_type.Equals("init"))
					{
						initialized.AddOrUpdate(curr_rr_cmd.uuid, true, (key, oldvalue) => oldvalue);
					}
					else if (curr_rr_cmd.command_type.Equals("config") )
					{
						configured.AddOrUpdate(curr_rr_cmd.uuid, true, (key , oldvalue) => oldvalue);
                    //Console.WriteLine(string.Format("updated status of configured {0}", configured[curr_rr_cmd.uuid]));
                    //Console.WriteLine(configured[curr_rr_cmd.uuid]);
					}
					curr_rr_cmd = null;

				}
				SendToUserInterface(_node_ipv6addr, _common_name, _serial_num, msg_bytes);
			}
		}

		private void ProcessDataResponse(byte[] msg_bytes)
		{
			UInt16 tmpu16;
			byte [] mod_bytes;
			Console.WriteLine(string.Format("Sending Data response to ui; length = {0}", msg_bytes.Length));
			if (link_qti > 0)
			{
				// need to add link quality indicator to message bytes ( 2 bytes for link quality id, and 2 bytes for teh value)
				mod_bytes = new byte[msg_bytes.Length + 4]; // for link quality indication (current reproted values in range 0x00-0xFF but using uint16 for future upgrades)
				// it is data response, only then modify the capability
				Array.Copy(msg_bytes, mod_bytes, msg_bytes.Length);
				tmpu16 = BitConverter.ToUInt16(msg_bytes,0); // msg szie of first packet 
				tmpu16 += 4;
				byte[] tmpb2 = BitConverter.GetBytes(tmpu16);
				mod_bytes[0] = tmpb2[0];
				mod_bytes[1] = tmpb2[1];
				tmpu16 = BitConverter.ToUInt16(msg_bytes,4); // number of capability ids in message
				tmpu16 += 1;
				byte[] tmpb = BitConverter.GetBytes(tmpu16);
				mod_bytes[4] = tmpb[0];
				mod_bytes[5] = tmpb[1];
				// little endian format
				mod_bytes[msg_bytes.Length] = (byte)( (ushort)ServiceNodeCapability.CPB_LINK_QUALITY & 0x00FF );
				mod_bytes[msg_bytes.Length+1] = (byte)( ((ushort)ServiceNodeCapability.CPB_LINK_QUALITY & 0xFF00) >> 8 );
				mod_bytes[msg_bytes.Length+2] = (byte)link_qti;
				link_qti = -1;
				mod_bytes[msg_bytes.Length+3] = 0x00;
				//Console.WriteLine("finished modifying recv message data confirmation");
				SendToUserInterface(_node_ipv6addr, _common_name, _serial_num, mod_bytes);
			}
			else 
			{
				SendToUserInterface(_node_ipv6addr, _common_name, _serial_num, msg_bytes);
			}

		}

		private void ProcessBridgeNodeDataResponse(byte[] msg_bytes)
		{
			UInt16 tmpu16_1;
			byte [] mod_bytes;
			
			Console.WriteLine(string.Format("Sending Data response to ui; length = {0}", msg_bytes.Length));
			tmpu16_1 = BitConverter.ToUInt16(msg_bytes, 0); // total len of msg_bytes
			mod_bytes = new byte[tmpu16_1-2];
			System.Array.Copy(msg_bytes, 2, mod_bytes, 0, tmpu16_1-2 );
			SendToUserInterface(_node_ipv6addr, _common_name, _serial_num, msg_bytes);

		}



