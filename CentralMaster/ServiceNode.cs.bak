		#region update_funcs
		public bool SetLoadOnOff(bool control)
		{
			// if control is true, then turn load on => value is 1
			// if control is false, then turn load off => value is 0

			//TODO: Send Command turnonoff with value based on control
			int index = Array.IndexOf(NODE_CAPABILITY_NAMES, "CPB_ONOFF");
			if (index < 0)
			{
				return false;
			}
			if (_capability.Contains(NODE_CAPABILITY_IDS[index]))
			{
				ushort[] cmd_ids = new ushort[1];
				cmd_ids[0] = NODE_CAPABILITY_IDS[index];
				ushort pkt_len = ProtocolMessagesG3PLC.CommandRequestPacketLen(cmd_ids, (ushort)cmd_ids.Length);
				byte[] pkt = new byte[pkt_len];
				byte update_val;
				if (control)
				{
					update_val = 1;
				}
				else
				{
					update_val = 0;
				}
				byte insert_at = ProtocolMessagesG3PLC.CommandRequestPacketInit(pkt, pkt_len);
				//var update_val_handle = GCHandle.Alloc(update_val, GCHandleType.Pinned);
				//var update_val_ptr = update_val_handle.AddrOfPinnedObject();
				insert_at = ProtocolMessagesG3PLC.CommandRequestPacketAppend(pkt, pkt_len, insert_at, cmd_ids[0], BitConverter.GetBytes(update_val));
				byte[] combo_pkt = new byte[pkt_len+2];
				ushort combo_pkt_len = ProtocolMessagesG3PLC.AppendPacket(combo_pkt, (ushort)(pkt_len + 2), false, pkt, (ushort)pkt.Length);
				//update_val_handle.Free();
				TransmitDataToNode(combo_pkt, _node_ipv6addr, true);
				if (control)
				{
					this._props.ServiceNodeStatus = "Sent Turn ON Command to Node";
				}
				else
				{
					this._props.ServiceNodeStatus = "Sent Turn OFF Command to Node";
				}
				return true;
			}
			else
			{
				// this node not contain on off capability
				return false;
			}

		}

		public bool SetLogging(bool control)
		{
			// if control is true, then turn logging on 
			// if control is false, then turn logging off 

			if (control)
			{
				if (this._do_log != true)
				{
					this._do_log = true;
					//this._log_btn_txt = "Disable Logging";
					this.Props.LogBtnTxt = "Disable Logging";
					this._props.ServiceNodeStatus = "Logging Turned ON";
				}
				// else it is already logging ignore command
			}
			else
			{
				if (this._do_log != false)
				{
					this._do_log = false;
					//this._log_btn_txt = "Enable Logging";
					this.Props.LogBtnTxt = "Enable Logging";
					this._props.ServiceNodeStatus = "Logging Turned OFF";
				}
				// else logging is stopped no need to repeat it again
			}
			return true;

		}

		public bool SetReportInterval(string rep_int_str)
		{
			//TODO: Send Command turnonoff with value based on control
			int index = Array.IndexOf(NODE_CAPABILITY_NAMES, "CPB_REPORT_INTERVAL");
			if (index < 0)
			{
				return false;
			}
			uint report_interval_value;
			bool succ = uint.TryParse(rep_int_str, out report_interval_value);
			if (!succ)
			{
				this._props.ServiceNodeStatus = string.Format("Failed to parse reporting interval {0}", rep_int_str);
				return false;
			}

			if (_capability.Contains(NODE_CAPABILITY_IDS[index]))
			{
				ushort[] cmd_ids = new ushort[1];
				cmd_ids[0] = NODE_CAPABILITY_IDS[index];
				ushort pkt_len = ProtocolMessagesG3PLC.CommandRequestPacketLen(cmd_ids, (ushort)cmd_ids.Length);
				byte[] pkt = new byte[pkt_len];
				byte insert_at = ProtocolMessagesG3PLC.CommandRequestPacketInit(pkt, pkt_len);
				//var report_interval_handle = GCHandle.Alloc(report_interval_value, GCHandleType.Pinned);
				//var report_interval_ptr = report_interval_handle.AddrOfPinnedObject();
				insert_at = ProtocolMessagesG3PLC.CommandRequestPacketAppend(pkt, pkt_len, insert_at, cmd_ids[0], BitConverter.GetBytes(report_interval_value));
				//report_interval_handle.Free();
				byte[] combo_pkt = new byte[pkt_len+2];
				ushort combo_pkt_len = ProtocolMessagesG3PLC.AppendPacket(combo_pkt, (ushort)(pkt_len + 2), false, pkt, (ushort)pkt_len);
				TransmitDataToNode(combo_pkt, _node_ipv6addr, true);
				return true;
			}
			else
			{
				// this node not contain on off capability
				return false;
			}

		}

		public bool SetBrightnessLevel(string intensity_str)
		{
			//TODO: Send Command intensity with value in parameter
			int index = Array.IndexOf(NODE_CAPABILITY_NAMES, "CPB_INTENSITY");
			if (index < 0)
			{
				return false;
			}
			ushort new_intensity_value;
			bool succ = ushort.TryParse(intensity_str, out new_intensity_value);
			if (!succ)
			{
				this._props.ServiceNodeStatus = string.Format("Failed to parse brightness value {0}", intensity_str);
				return false;
			}

			if (new_intensity_value < 10)
			{
				new_intensity_value = 10;
				this._props.ServiceNodeStatus = string.Format("Lowest brightness % value is 10, using lower limit, value set was {0}", intensity_str);
			}

			if (new_intensity_value > 100)
			{
				new_intensity_value = 100;
				this._props.ServiceNodeStatus = string.Format("Highest brightness % value is 100, using upper limit, value set was {0}", intensity_str);
			}


			if (_capability.Contains(NODE_CAPABILITY_IDS[index]))
			{
				ushort[] cmd_ids = new ushort[1];
				cmd_ids[0] = NODE_CAPABILITY_IDS[index];
				ushort pkt_len = ProtocolMessagesG3PLC.CommandRequestPacketLen(cmd_ids, (ushort)cmd_ids.Length);
				byte[] pkt = new byte[pkt_len];
				byte insert_at = ProtocolMessagesG3PLC.CommandRequestPacketInit(pkt, pkt_len);
				//var report_interval_handle = GCHandle.Alloc(new_intensity_value, GCHandleType.Pinned);
				//var report_interval_ptr = report_interval_handle.AddrOfPinnedObject();
				insert_at = ProtocolMessagesG3PLC.CommandRequestPacketAppend(pkt, pkt_len, insert_at, cmd_ids[0], BitConverter.GetBytes(new_intensity_value));
				//report_interval_handle.Free();
				byte[] combo_pkt = new byte[pkt_len + 2];
				ushort combo_pkt_len = ProtocolMessagesG3PLC.AppendPacket(combo_pkt, (ushort)(pkt_len + 2), false, pkt, (ushort)pkt_len);
				TransmitDataToNode(combo_pkt, _node_ipv6addr, true);
				return true;
			}
			else
			{
				// this node not contain on off capability
				return false;
			}

		}

		public bool SetSchedule(DateTime[] sch_times, byte[] sch_intensity_pc)
		{
			// assumed that the data in sch_times is all ordered. this simply sends the data to the node
			string tmpstr;
			if (_current_state >= (ushort)ServiceNodeStates.CAPABILITY)
			{
				// schedule can be sent
				// convert schedule to an array
				if (sch_times.Length != sch_intensity_pc.Length)
				{
					return false;
				}
				else
				{
					byte[] sch_row_bytes = new byte[sch_times.Length * 7];
					int jj = 0;
					for (int ii = 0; ii < sch_times.Length; ii++)
					{
						tmpstr = sch_times[ii].ToString("HH:mm:ss").Replace(":", "");
						byte[] tmpb = ASCIIEncoding.ASCII.GetBytes(tmpstr);
						Array.Copy(tmpb, 0, sch_row_bytes, jj, tmpb.Length);
						jj += 6;
						sch_row_bytes[jj] = sch_intensity_pc[ii];
						jj += 1;
					}
					ushort pkt_len = ProtocolMessagesG3PLC.ScheduleCommandPacketLen((ushort)sch_times.Length);
					byte[] pkt = new byte[pkt_len];
					ProtocolMessagesG3PLC.ScheduleCommandPacket(pkt, pkt_len, sch_row_bytes, (ushort)sch_row_bytes.Length, (ushort)sch_times.Length);
					byte[] combo_pkt = new byte[pkt_len + 2];
					ushort combo_pkt_len = ProtocolMessagesG3PLC.AppendPacket(combo_pkt, (ushort)(pkt_len+2), false, pkt, (ushort)pkt_len);
					TransmitDataToNode(pkt, _node_ipv6addr, true);
					return true;
				}
			}
			else
			{
				return false;
			}
		}

		public int NumberOfCommands()
		{
			string node_cmd_filename = _common_name + "-" + _serial_num + ".json";
			string node_fname = System.IO.Path.Combine("NodesInfo", node_cmd_filename);
			int number_of_commands = 0;
			RRCommand rr_cmd;
			// clear concurrent queue; it should be empty
			if (!sn_rr_queue.IsEmpty)
			{
				while (sn_rr_queue.TryDequeue(out rr_cmd));
			}

			if (node_devices == null )
			{
				if (System.IO.File.Exists(node_fname))
				{
					string json_str = System.IO.File.ReadAllText(node_fname);
					try
					{
						NodeDevices ndevs = JsonSerializer.Deserialize<NodeDevices>(json_str);
						//NodeDevices ndevs = JsonConvert.DeserializeObject<NodeDevices>(json_str);
						node_devices = ndevs;
					}
					catch (System.Exception e)
					{
						Console.WriteLine(e.Message);
						node_devices = null;
					}
				}
				else
				{
					node_devices = null;
				}
			}
			else
			{
				// TODO: has it changed? how to do it and udpate commands
			}

			if ( node_devices != null ) 
			{
				foreach (DeviceInfo di in node_devices.devices)
				{
					if ( di.config_command.Length != 0 )
					{
                        //Console.WriteLine(string.Format("uuid {0}, exits in configure {1}", di.uuid, configured.ContainsKey(di.uuid)));
                        //if (configured.ContainsKey(di.uuid))
                        //{
                            //Console.WriteLine(configured[di.uuid]);
                        //}
						if ( 
							( ( configured.ContainsKey(di.uuid) ) &&  ( configured[di.uuid] == false ) ) ||
							( !configured.ContainsKey(di.uuid) )
						)
						{
							RRCommand tmp_rr_cmd = new RRCommand();
							tmp_rr_cmd.uuid = di.uuid;
							tmp_rr_cmd.device_name = di.device;
							tmp_rr_cmd.command_name = di.config_command;
							tmp_rr_cmd.command_type = "config";
							configured.AddOrUpdate(di.device, false, (key, oldvalue) => oldvalue);
							sn_rr_queue.Enqueue(tmp_rr_cmd);
						}
					}

					if ( di.init_command.Length != 0 )
					{


                        //Console.WriteLine(string.Format("uuid {0}, exits in configure {1}", di.uuid, initialized.ContainsKey(di.uuid)));
                        //if (initialized.ContainsKey(di.uuid))
                        //{
                        //     Console.WriteLine(initialized[di.uuid]);
                        //}
						if ( 
							( ( initialized.ContainsKey(di.uuid) ) &&  ( initialized[di.uuid] == false ) ) ||
							( !initialized.ContainsKey(di.uuid) )
						)
						{
							RRCommand tmp_rr_cmd = new RRCommand();
							tmp_rr_cmd.uuid = di.uuid;
							tmp_rr_cmd.device_name = di.device;
							tmp_rr_cmd.command_name = di.init_command;
							tmp_rr_cmd.command_type = "init";
							initialized.AddOrUpdate(di.device, true, (key, oldvalue) => oldvalue);
							sn_rr_queue.Enqueue(tmp_rr_cmd);
						}
					}

					// ignore order for now
					foreach ( DataCommand dc in di.data_commands )
					{
						RRCommand tmp_rr_cmd = new RRCommand();
						tmp_rr_cmd.uuid = di.uuid;
						tmp_rr_cmd.device_name = di.device;
						tmp_rr_cmd.command_name = dc.name;
						tmp_rr_cmd.command_type = "data";
						sn_rr_queue.Enqueue(tmp_rr_cmd);
					}

				}
				return sn_rr_queue.Count;				
			}
			else
			{
				return 1;
			}
		}

		public void SendCommandWithTimeout(int command_index)
		{
			if (node_devices == null) 
			{
				curr_rr_cmd = null;
				SendDCRequestEventWithTimeout("data", null);
			}
			else
			{
				RRCommand to_send_rrcmd;
				bool sts;
				sts = sn_rr_queue.TryDequeue(out to_send_rrcmd);
                //Console.WriteLine(string.Format("SENDING COMMAND = > {0}", to_send_rrcmd.command_name));
				if (sts)
				{
					curr_rr_cmd = to_send_rrcmd;
					SendDCRequestEventWithTimeout(DeviceData.GetChannelNameForDevice(to_send_rrcmd.device_name),
						to_send_rrcmd);
				}
			}
		}

		public bool SendDCRequestEventWithTimeout(string req_type, RRCommand send_rr_cmd)
		{
			bool sts;
			ushort pkt_len = 0;
			byte[] pkt = null;
			byte[] combo_pkt = null;

			if (req_type.ToLower().Equals("core") )
			{
				if (send_rr_cmd.command_name.Equals("GetPowerData"))
				{
					pkt_len = ProtocolMessagesG3PLC.DataRequestPacketLen();
					pkt = new byte[pkt_len];
					combo_pkt = new byte[pkt_len + 2];
					ProtocolMessagesG3PLC.DataRequestPacket(pkt, pkt_len);
					ProtocolMessagesG3PLC.AppendPacket(combo_pkt, (ushort)(pkt_len+2), false, pkt, pkt_len);
				}
				else 
				{
					Console.WriteLine(string.Format("Invalid command recv Channel: {0}, CmdName: {1}", req_type, send_rr_cmd.command_name));
				}
			}
			else if (req_type.ToLower().Equals("rs232") )
			{
				JsonGetCommand send_json_cmd = DeviceData.GetCommand(send_rr_cmd.device_name, send_rr_cmd.command_name);
				// possible types: config, init, data
				byte[] cmd_data = GetRs232CommandData(send_json_cmd);
				pkt_len = ProtocolMessagesG3PLC.RS232CommandPacketLen(cmd_data);
                pkt = new byte[pkt_len];
                ProtocolMessagesG3PLC.RS232CommandPacket(pkt, pkt_len, cmd_data);
				combo_pkt = new byte[pkt_len + 2];
				combo_pkt[0] = (byte)(pkt_len+2);
				combo_pkt[1] = (byte)((pkt_len+2) >> 8);
				ProtocolMessagesG3PLC.AppendPacket(combo_pkt, (ushort)(pkt_len+2), false, pkt, pkt_len);
			}


			if (pkt_len == 0)
			{
				return false; // cannot do any furhter processing => probably invalid command
			}
			_data_cmd_time = DateTime.Now;
			TransmitDataToNode(combo_pkt, _node_ipv6addr, true);
			//Console.WriteLine("callling recv autoreset reset and waitone 3000 ");
			confirmation_recv_event.Reset();
			sts = confirmation_recv_event.WaitOne(rd_confirmation_timeout_millisecs);
			if (sts)
			{
				Console.WriteLine("Confirmation received. Wait for data request response");
				resp_recv_event.Reset();
				sts = resp_recv_event.WaitOne(rd_rx_timeout_milliseconds);
			}
			else 
			{
				Console.WriteLine(String.Format("Confirmation NOT received in {0} seconds", rd_confirmation_timeout_millisecs/ 1000));
			}
			return sts;
		}

		public byte[] GetRs232CommandData(JsonGetCommand send_json_cmd)
		{
			byte[] data_2_send = null;
			if (send_json_cmd.send_type.Equals("string", StringComparison.CurrentCultureIgnoreCase))
			{
				if (send_json_cmd.name.ToLower().Equals("config"))
				{
					// parse the send command
					// format "<speed>, <num bits>, <parity values: N [None], O[Odd], E[Even], <num stop bits>, delimiter byte, 0/1 (xon_xoff disable/enable)"
					//For Parity N => 0,  E => 1, O => 2
					string[] data_str = send_json_cmd.send_command.Split(',');
					if (data_str.Length != 6)
					{
						System.Console.WriteLine(string.Format("expected config format \"baud rate, num bits, parity(N/E/O), stopbits,delimiter char as int, 0/1 (disable/enable SW flow control xon_xoff\", got {0}", 
							send_json_cmd.send_command));
						System.Console.WriteLine(string.Format("Cannot parse and send config commands"));
						return null;
					}
					data_2_send = new byte[11];
					// config uint8 =0, address_uint8, 
					// Baud_uint32, parity_uint8, { 0 = none, 1 = even, 2 = odd }, 
					//     numberOfBits_uint8, numberOfStopBits_uint8, delimiter _uint8 { 0x10 or 0x13 typically}
					data_2_send[0] = 0; // it is config data
					data_2_send[1] = 0; // address_uint8
					byte[] tmpb = BitConverter.GetBytes( (Convert.ToUInt32(data_str[0])) );
					data_2_send[2] = tmpb[0];
					data_2_send[3] = tmpb[1];
					data_2_send[4] = tmpb[2];
					data_2_send[5] = tmpb[3];
					if (data_str[1].ToLower().StartsWith("n")) // parity
					{
						data_2_send[6] = 0;
					}
					else if (data_str[1].ToLower().StartsWith("e"))
					{
						data_2_send[6] = 1;
					}
					else if (data_str[1].ToLower().StartsWith("o"))
					{
						data_2_send[6] = 2;
					}
					else
					{
						// invalid parity setting
						System.Console.WriteLine("Invalid parity setting, expected N,E or O");
						return null;
					}
					data_2_send[7] = Convert.ToByte(data_str[2]); // num bits
					data_2_send[8] = Convert.ToByte(data_str[3]); // num stop bits
					data_2_send[9] = Convert.ToByte(data_str[4]); // delimiter
					data_2_send[10] = Convert.ToByte(data_str[5]); // enable / disable software flow control
				}
				else
				{
					//byte[] tmpb = System.Text.Encoding.ASCII.GetBytes(dev_rs232_cmds.commands[index].send_command);
					MemoryStream ms = new MemoryStream();
					foreach (char tmpch in send_json_cmd.send_command)
					{
						ms.WriteByte((byte)tmpch);
					}
					byte[] tmpb = ms.ToArray();
					data_2_send = new byte[tmpb.Length + 2];
					data_2_send[0] = 1; // 0=> config, 1 => command
					data_2_send[1] = 0; // addressa is always zero for rs232 commands
					System.Array.Copy(tmpb, 0, data_2_send, 2, tmpb.Length);
				}
			}
			else if (send_json_cmd.send_type.Equals("binary", StringComparison.CurrentCultureIgnoreCase))
			{
				byte[] tmpb = ParseBinaryCommand(send_json_cmd.send_command);
				data_2_send = new byte[tmpb.Length + 2];
				data_2_send[0] = 1; // 0=> config, 1 => command
				data_2_send[1] = 0; // addressa is always zero for rs232 commands
				System.Array.Copy(tmpb, 0, data_2_send, 2, tmpb.Length);
			}
			return data_2_send;
		}

        private byte[] ParseBinaryCommand(string bin_cmd_str)
        {
            byte[] to_ret = null;
            int ii;
            bool parse_sts;
            byte tmpb;
            string[] bytes_str = bin_cmd_str.Split(new char[] { ',' });
            parse_sts = true;
            if (bytes_str.Length > 0)
            {
                to_ret = new byte[bytes_str.Length];
                ii = 0;
                parse_sts = true;
                while ((ii < bytes_str.Length) && (parse_sts))
                {
                    if ((bytes_str[ii].Trim().StartsWith("0x")) ||
                         (bytes_str[ii].Trim().StartsWith("0X"))
                        )
                    {
                        parse_sts = byte.TryParse(bytes_str[ii].Trim().Substring(2), System.Globalization.NumberStyles.HexNumber, null, out tmpb);
                        if (parse_sts)
                        {
                            to_ret[ii] = tmpb;
                        }
                    }
                    else
                    {
                        parse_sts = byte.TryParse(bytes_str[ii].Trim(), out tmpb);
                        if (parse_sts)
                        {
                            to_ret[ii] = tmpb;
                        }
                    }
                    ii++;
                }
            }
            if (parse_sts)
            {
                return to_ret;
            }
            else
            {
                return null;
            }
        }

		public bool SendProtocolSetupRequestEventWithTimeout()
		{
			bool sts;
			if (_pause_state_machine == true)
			{
				_pause_state_machine = false;
			}
			if (_current_state != (ushort)ServiceNodeStates.PROTOCOL_SETUP)
			{
				_current_state = (ushort)ServiceNodeStates.PROTOCOL_SETUP;
			}
			ushort pkt_len1 = ProtocolMessagesG3PLC.CommonNameRequestPacketLen();
			ushort pkt_len2 = ProtocolMessagesG3PLC.SyncTimeRequestPacketLen();
			ushort pkt_len3 = ProtocolMessagesG3PLC.CapabilityRequestPacketLen();
			ushort combo_pkt_len = (ushort)(pkt_len1 + pkt_len2 + pkt_len3+2);
			byte[] combo_pkt = new byte[combo_pkt_len];

			byte[] pkt1 = new byte[pkt_len1];
			ProtocolMessagesG3PLC.CommonNameRequestPacket(pkt1, pkt_len1);
			ushort tmpu2 = ProtocolMessagesG3PLC.AppendPacket(combo_pkt, combo_pkt_len, false, pkt1, pkt_len1);

			byte[] pkt2 = new byte[pkt_len2];
			byte[] time_b;
			StringBuilder sb = new StringBuilder();
			DateTime curr_time = DateTime.Now;
			sb.Append(string.Format("{0:d2}{1:d2}{2:d2}", curr_time.Month, curr_time.Day, curr_time.Year - 2000));
			sb.Append(string.Format("{0:d2}{1:d2}{2:d2}", curr_time.Hour, curr_time.Minute, curr_time.Second));
			sb.Append(string.Format("{0:d2}", (int)curr_time.DayOfWeek ) );
			time_b = ASCIIEncoding.ASCII.GetBytes(sb.ToString());
			ProtocolMessagesG3PLC.SyncTimeRequestPacket(pkt2, pkt_len2, time_b, (ushort)time_b.Length);
			tmpu2 = ProtocolMessagesG3PLC.AppendPacket(combo_pkt, combo_pkt_len, true, pkt2, pkt_len2);

			byte[] pkt3 = new byte[pkt_len3];
			ProtocolMessagesG3PLC.CapabilityRequestPacket(pkt3, pkt_len3);
			tmpu2 = ProtocolMessagesG3PLC.AppendPacket(combo_pkt, combo_pkt_len, true, pkt3, pkt_len3);
			_data_cmd_time = DateTime.Now; // we get a data response with proto setup too; so it could also be considered a command

			TransmitDataToNode(combo_pkt, _node_ipv6addr, true);
			//Console.WriteLine("callling recv autoreset reset and waitone 3000 ");
			confirmation_recv_event.Reset();
			sts = confirmation_recv_event.WaitOne(rd_confirmation_timeout_millisecs);
			if (sts)
			{
				Console.WriteLine("Confirmation received. Wait for Protocol request response");
				resp_recv_event.Reset();
				sts = resp_recv_event.WaitOne(rd_rx_timeout_milliseconds);
			}
			else 
			{
				Console.WriteLine(String.Format("Confirmation NOT received in {0} seconds.", rd_confirmation_timeout_millisecs/1000));
			}
			return sts;
		}

		#endregion // update_funcs

		#region ui_funcs
		private void SendToUserInterface(byte[] ipv6_address, string common_name, string serial_num, byte[] data_to_send)
		{
			if (_itransmit_comms == null)
			{
				// cannot send any data to ui; display in console
				Console.WriteLine(String.Format("ipv6 [{0}], name -> {1}, data ->{2}",
					_node_ipv6addr_str,
					common_name + ";" + serial_num,
				                                BitConverter.ToString(data_to_send, 0, data_to_send.Length)));
				return;
			}

			//Console.WriteLine("in SentToUserInterface function");
			// data format: ipv6_address bytes, length => 2 bytes
			//              common_name + ";" + serial_num (corresponding to length bytes)
			//              length of data => 2 bytes, data (as per length specified in the prev 2 bytes)
			try
			{
				int tmp_b_len = 2 + ASCIIEncoding.ASCII.GetByteCount(common_name) + // note 2 is for length of common_name and serial_number that follows
								ASCIIEncoding.ASCII.GetByteCount(serial_num) + 1;// note: 1 is for ";" that separates common name and serial number
				int data_b_len = ipv6_address.Length + tmp_b_len + data_to_send.Length; 
				byte[] data_b = new byte[data_b_len];
				System.Array.Copy(ipv6_address, 0, data_b, 0, ipv6_address.Length);
				//Console.WriteLine("Finished copy ipv6 address");
				data_b[ipv6_address.Length] = (byte)(tmp_b_len & 0xFF);
				data_b[ipv6_address.Length + 1] = (byte)(tmp_b_len >> 8);
				byte[] tmp_b = new byte[tmp_b_len];
				tmp_b = ASCIIEncoding.ASCII.GetBytes(common_name + ';' + serial_num);
				System.Array.Copy(tmp_b, 0, data_b, ipv6_address.Length + 2, tmp_b_len-2);
				//Console.WriteLine("Finished copy common name and serial num");
				//data_b[ipv6_address.Length + tmp_b_len] = (byte)(data_to_send.Length & 0xFF);
				//data_b[ipv6_address.Length + tmp_b_len + 1] = (byte)(data_to_send.Length >> 8);

				System.Array.Copy(data_to_send, 0, data_b, ipv6_address.Length + tmp_b_len, data_to_send.Length);
				//Console.WriteLine("ready to send data");
				_itransmit_comms.transmit(data_b);
			}
			catch (Exception e)
			{
				Console.WriteLine(e.Message);
				Console.WriteLine(e.StackTrace);
			}
 		}



		public void ReceivedFromUserInterface(byte[] data_recv)
		{
			// TODO: // add code here to process data
			// data recv contains ipv6 address; <2byte length>, common_name+ ";" + serialnumber, data_recv
			bool ipv6_verified;
			bool name_verified;
			int ii, jj;
			//if (data_recv.Length < _node_ipv6addr.Length)
			//{
			//	ipv6_verified = false;
			//}
			//else
			//{
			//	ii = 0;
			//	ipv6_verified = true;
			//	while ((ii < _node_ipv6addr.Length) && ipv6_verified == true)
			//	{
			//		if (_node_ipv6addr[ii] != data_recv[ii])
			//		{
			//			ipv6_verified = false;
			//		}
			//		ii++;
			//	}	
			//}
			ipv6_verified = true; // done at the main layer
			name_verified = false;
			//ii = 2 + ASCIIEncoding.ASCII.GetByteCount(_common_name) + 1 + ASCIIEncoding.ASCII.GetByteCount(_serial_num);
			ii = BitConverter.ToUInt16(data_recv, _node_ipv6addr.Length);
			string tmpstr = ASCIIEncoding.ASCII.GetString(data_recv, _node_ipv6addr.Length+2, ii-2);
			string[] tmp_parts = tmpstr.Split(new char[] {';'});
			if (ipv6_verified)
			{
				/*
				two formats of data can be recievedhere
				<ipv6 address><length: uint16><common name>;<serial number><Single SingleDataPacket>
						OR
				<ipv6 address><length: uint16><common name;serial number><BridgeNodeSingleDataPacket>
				*/
				if ( (tmp_parts[0].Equals(_common_name)) && (tmp_parts[1].Equals(_serial_num)) )
				{
					name_verified = true;
				}
				else
				{
					name_verified = false;
				}
			}

			Console.WriteLine(string.Format("ipv6 verified => {0}, name_verified = {1}", ipv6_verified, name_verified));
			if (ipv6_verified && name_verified)
			{
				jj = _node_ipv6addr.Length + ii; // + 4;
				byte[] tmp_recv_b = new byte[data_recv.Length - jj];
				System.Array.Copy(data_recv, jj, tmp_recv_b, 0, tmp_recv_b.Length);
				byte[]  combo_pkt = new byte[tmp_recv_b.Length + 2];
				byte[] tmp_b = BitConverter.GetBytes((ushort)(combo_pkt.Length));
				combo_pkt[0] = tmp_b[0];
				combo_pkt[1] = tmp_b[1];
				System.Array.Copy(tmp_recv_b, 0, combo_pkt, 2, tmp_recv_b.Length);
				//ushort combo_pkt_len = ProtocolMessagesG3PLC.AppendPacket(combo_pkt, (ushort)(tmp_recv_b.Length + 2), false, tmp_recv_b, (ushort)tmp_recv_b.Length);
				TransmitDataToNode(combo_pkt, _node_ipv6addr, true);
				confirmation_recv_event.Reset();
				confirmation_recv_event.WaitOne();
				Console.WriteLine("Confirmation received. Wait for data request response");

				resp_recv_event.Reset();
				resp_recv_event.WaitOne(rd_rx_timeout_milliseconds);

			}
		}

		public void SendTimeoutResponseToUserInterface()
		{
			// sends timeouit response only if the RS232 command id was received
			switch (transmit_id) {
				case (ushort)ProtocolIdentifiers.RS232_COMMAND_ID:
					byte[] msg_bytes = ASCIIEncoding.ASCII.GetBytes("Error: Timeout");
					ushort pkt_len = ProtocolMessagesG3PLC.RS232ResponsePacketLen((ushort)msg_bytes.Length);
					byte[] pkt = new byte[pkt_len];
					ProtocolMessagesG3PLC.RS232ResponsePacket(pkt, pkt_len,msg_bytes, (ushort)msg_bytes.Length, 0xff); 
					SendToUserInterface(_node_ipv6addr, _common_name, _serial_num, pkt);					
					break;
			}
		}
